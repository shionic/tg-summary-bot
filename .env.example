# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# AI API Configuration
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-3.5-turbo

# Bot Configuration
MESSAGE_LIMIT=100
DATABASE_PATH=bot_data.db

# Thread Handling
# If true - each thread gets separate summary
# If false - all threads combined in one summary with thread context
THREADED_SEPARATED=true

# Automatic Summary Schedule
# Enable automatic summaries at specified time (true/false)
AUTO_SUMMARY_ENABLED=false
# Time to send automatic summary (24-hour format HH:MM, e.g., 09:00 or 18:30)
AUTO_SUMMARY_TIME=09:00
# Chat ID where to send automatic summaries (get from @userinfobot)
AUTO_SUMMARY_CHAT_ID=
